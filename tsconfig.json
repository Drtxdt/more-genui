{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "entrypoints/**/*.ts",
    "src/**/*.ts",
    "packages/harness/src/**/*.ts",
    "packages/harness/src/**/*.tsx",
    "wxt.config.ts"
  ]
}
