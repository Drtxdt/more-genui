{
  "version": 1,
  "id": "fast-stepper",
  "title": "fast-stepper",
  "stateVersion": 1,
  "kind": "stepper",
  "steps": [
    {
      "title": "开始",
      "text": "先观察原文法",
      "frame": {
        "kind": "compare",
        "before": {
          "label": "变换前",
          "lines": [
            "E → E + T | T"
          ]
        },
        "after": {
          "label": "变换后",
          "lines": [
            "E → T E_tail",
            "E_tail → + T E_tail | ε"
          ]
        },
        "note": "新的非终结符表示后续的零次或多次 + T。"
      }
    },
    {
      "title": "定位冲突",
      "text": "单元格可查看产生式进入的依据",
      "frame": {
        "kind": "matrix",
        "rows": [
          "S",
          "A"
        ],
        "columns": [
          "a",
          "$"
        ],
        "cells": [
          {
            "row": "S",
            "column": "a",
            "text": "S → A a",
            "explanation": "a 属于 FIRST(A a)"
          },
          {
            "row": "A",
            "column": "a",
            "text": "A → a / A → ε",
            "conflict": true,
            "explanation": "第一项来自 FIRST，第二项来自 FOLLOW(A)={a}。"
          }
        ]
      }
    }
  ]
}
