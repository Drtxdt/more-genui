    "<!-- more-genui: {\"version\":1,\"id\":\"wave-1\",\"title\":\"正弦波振幅和频率\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>正弦波</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#4fc3f7}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:760px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\ncanvas{width:100%;height:auto;display:block;border-radius:10px;background:#0b101b}\n.c{margin-top:12px}.r{display:flex;justify-content:space-between;font-size:.8rem;color:#9aa7c2;margin-bottom:4px}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.f{margin-top:8px;font-size:.8rem;color:#9aa7c2}\n</style></head><body><div class=\"w\">\n<h1>正弦波：y = A·sin(2πf·t)</h1>\n<p class=\"s\">A 为振幅（波峰高度），f 为频率（每秒周期数）；周期 T=1/f。</p>\n<canvas id=\"cv\" width=\"720\" height=\"260\"></canvas>\n<div class=\"c\"><div class=\"r\"><span>振幅 A</span><span id=\"oa\">1.00</span></div>\n<input id=\"a\" type=\"range\" min=\"0.1\" max=\"1\" step=\"0.01\" value=\"0.6\" aria-label=\"振幅\"></div>\n<div class=\"c\"><div class=\"r\"><span>频率 f (Hz)</span><span id=\"of\">1.00</span></div>\n<input id=\"f\" type=\"range\" min=\"0.2\" max=\"5\" step=\"0.05\" value=\"1\" aria-label=\"频率\"></div>\n<p class=\"f\">周期 T = <span id=\"ot\">1.00</span> s</p>\n</div>\n<script>(function(){\nvar D={a:0.6,f:1},S=Object.assign({},D);\ntry{if(genui&&genui.getState){var g=genui.getState();if(g&&typeof g===\"object\"){S.a=Math.min(1,Math.max(.1,+g.a||D.a));S.f=Math.min(5,Math.max(.2,+g.f||D.f));}}}catch(e){}\nvar cv=document.getElementById(\"cv\"),ctx=cv.getContext(\"2d\");\nvar aE=document.getElementById(\"a\"),fE=document.getElementById(\"f\");\nvar oa=document.getElementById(\"oa\"),of=document.getElementById(\"of\"),ot=document.getElementById(\"ot\");\nfunction save(){try{genui.setState(S)}catch(e){}}\nfunction draw(ph){\n var W=cv.width,H=cv.height,mid=H/2,ampPx=H*0.42;\n ctx.clearRect(0,0,W,H);ctx.strokeStyle=\"#1c2538\";ctx.beginPath();\n for(var i=0;i<=4;i++){var x=i*W/4;ctx.moveTo(x,0);ctx.lineTo(x,H)}ctx.stroke();\n ctx.strokeStyle=\"#3a4a6b\";ctx.beginPath();ctx.moveTo(0,mid);ctx.lineTo(W,mid);ctx.stroke();\n ctx.strokeStyle=getComputedStyle(document.body).getPropertyValue(\"--accent\");ctx.lineWidth=2.4;ctx.beginPath();\n for(var k=0;k<=W;k++){var t=k/W*4,y=mid-S.a*ampPx*Math.sin(2*Math.PI*S.f*(t+ph));\n  k?ctx.lineTo(k,y):ctx.moveTo(k,y)}ctx.stroke();\n}\nfunction ui(){oa.textContent=S.a.toFixed(2);of.textContent=S.f.toFixed(2);ot.textContent=(1/S.f).toFixed(2);aE.value=S.a;fE.value=S.f}\naE.oninput=function(){S.a=+this.value;ui();save()};\nfE.oninput=function(){S.f=+this.value;ui();save()};\nui();var ph=0;\n(function loop(){ph=(ph+0.008)%1000;draw(ph);requestAnimationFrame(loop)})();\n})();</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"spring-1\",\"title\":\"理想弹簧振子\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>弹簧振子</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#7ee081}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:720px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\ncanvas{width:100%;height:auto;display:block;border-radius:10px;background:#0b101b}\n.r{display:flex;justify-content:space-between;font-size:.8rem;color:#9aa7c2;margin:12px 0 4px}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.f{margin-top:8px;font-size:.85rem}\n</style></head><body><div class=\"w\">\n<h1>理想弹簧振子（m = 1 kg）</h1>\n<p class=\"s\">无阻尼简谐运动：ω=√(k/m)，周期 T=2π√(m/k)。刚度 k 越大振动越快、周期越短。</p>\n<canvas id=\"cv\" width=\"700\" height=\"220\"></canvas>\n<div class=\"r\"><span>刚度 k (N/m)</span><span id=\"ok\">10.0</span></div>\n<input id=\"k\" type=\"range\" min=\"1\" max=\"100\" step=\"1\" value=\"20\" aria-label=\"刚度\">\n<p class=\"f\">周期 T = <span id=\"ot\">1.40</span> s &nbsp;|&nbsp; 角频率 ω = <span id=\"ow\">4.47</span> rad/s</p>\n</div>\n<script>(function(){\nvar D={k:20},S={k:D.k};\ntry{if(genui&&genui.getState){var g=genui.getState();if(g&&+g.k)S.k=Math.min(100,Math.max(1,+g.k));}}catch(e){}\nvar cv=document.getElementById(\"cv\"),ctx=cv.getContext(\"2d\");\nvar kE=document.getElementById(\"k\"),ok=document.getElementById(\"ok\"),ot=document.getElementById(\"ot\"),ow=document.getElementById(\"ow\");\nvar m=1,acc=0,last=0;\nfunction save(){try{genui.setState(S)}catch(e){}}\nfunction ui(){var w=Math.sqrt(S.k/m),T=2*Math.PI/w;ok.textContent=S.k.toFixed(1);ot.textContent=T.toFixed(2);ow.textContent=w.toFixed(2);kE.value=S.k}\nkE.oninput=function(){S.k=+this.value;ui();save()};\nfunction draw(){\n var W=cv.width,H=cv.height,mid=H/2,A=H*0.32,wallX=30,massX=120,massW=60;\n var w=Math.sqrt(S.k/m),x=A*Math.sin(w*acc);\n ctx.clearRect(0,0,W,H);\n ctx.strokeStyle=\"#3a4a6b\";ctx.lineWidth=3;ctx.beginPath();ctx.moveTo(wallX,mid-40);ctx.lineTo(wallX,mid+40);ctx.stroke();\n var cxp=massX+massW/2,mx=cxp+x;\n ctx.strokeStyle=getComputedStyle(document.body).getPropertyValue(\"--accent\");ctx.lineWidth=2;ctx.beginPath();\n var coils=12;for(var i=0;i<=coils*2;i++){var t=i/(coils*2),px=wallX+t*(mx-massW/2-wallX);var py=mid+((i%2)?-14:14)*Math.sin(Math.PI*t);i?ctx.lineTo(px,py):ctx.moveTo(px,py)}ctx.stroke();\n ctx.fillStyle=\"#233050\";ctx.strokeStyle=getComputedStyle(document.body).getPropertyValue(\"--accent\");ctx.lineWidth=2;\n ctx.fillRect(mx-massW/2,mid-massW/2,massW,massW);ctx.strokeRect(mx-massW/2,mid-massW/2,massW,massW);\n ctx.fillStyle=getComputedStyle(document.body).getPropertyValue(\"--fg\");ctx.font=\"14px system-ui\";ctx.textAlign=\"center\";\n ctx.fillText(\"m=1kg\",mx,mid+5);\n}\nfunction loop(ts){if(!last)last=ts;var dt=Math.min(.05,(ts-last)/1000);last=ts;acc+=dt;draw();requestAnimationFrame(loop)}\nui();draw();requestAnimationFrame(loop);\n})();</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"sort-1\",\"title\":\"冒泡排序逐步演示\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>冒泡排序</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#ffb74d}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:720px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\n#bars{display:flex;align-items:flex-end;gap:6px;height:200px;background:#0b101b;border-radius:10px;padding:10px}\n.bar{flex:1;background:#2a3550;border-radius:4px;transition:height .15s,background .15s;position:relative}\n.bar span{position:absolute;top:-18px;left:0;right:0;text-align:center;font-size:.75rem;color:#9aa7c2}\n.bar.cmp{background:#4fc3f7}.bar.swp{background:var(--accent)}.bar.done{background:#7ee081}\n.btns{margin-top:12px;display:flex;gap:8px;flex-wrap:wrap}\nbutton{background:#233050;color:var(--fg);border:1px solid #2a3550;border-radius:8px;padding:7px 14px;font-size:.82rem;cursor:pointer}\nbutton:hover{background:#2d3c62}\n.f{margin-top:8px;font-size:.8rem;color:#9aa7c2}\n</style></head><body><div class=\"w\">\n<h1>冒泡排序逐步演示</h1>\n<p class=\"s\">每趟从左到右比较相邻两项，逆序则交换；一趟结束最大值沉到末尾。</p>\n<div id=\"bars\"></div>\n<div class=\"btns\"><button id=\"step\">单步</button><button id=\"auto\">自动</button><button id=\"reset\">重置</button></div>\n<p class=\"f\" id=\"st\">准备就绪</p>\n</div>\n<script>(function(){\nvar BASE=[5,2,9,1,7,3,8,4];\nvar arr=[],i=0,j=0,sorted=0,steps=0,autoT=null,last={a:-1,b:-1,swap:false};\ntry{if(genui&&genui.getState){var g=genui.getState();}}catch(e){}\nfunction save(){try{genui.setState({i:i,j:j,sorted:sorted})}catch(e){}}\nvar bars=document.getElementById(\"bars\"),st=document.getElementById(\"st\");\nfunction render(){\n bars.innerHTML=\"\";\n arr.forEach(function(v,idx){\n  var d=document.createElement(\"div\");d.className=\"bar\";\n  d.style.height=(20+v*16)+\"px\";\n  if(idx>=arr.length-sorted)d.classList.add(\"done\");\n  if(idx===last.a||idx===last.b)d.classList.add(last.swap?\"swp\":\"cmp\");\n  var s=document.createElement(\"span\");s.textContent=v;d.appendChild(s);bars.appendChild(d);\n });\n}\nfunction reset(){arr=BASE.slice();i=0;j=0;sorted=0;steps=0;last={a:-1,b:-1,swap:false};st.textContent=\"准备就绪\";render();}\nfunction step(){\n if(sorted>=arr.length-1){st.textContent=\"已完成，共 \"+steps+\" 次交换\";return;}\n if(j>=arr.length-1-sorted){sorted++;j=0;render();save();return;}\n last={a:j,b:j+1,swap:false};\n if(arr[j]>arr[j+1]){var t=arr[j];arr[j]=arr[j+1];arr[j+1]=t;last.swap=true;steps++;}\n st.textContent=\"比较 (\"+arr[j+1]+\",\"+arr[j]+\") 位置 \"+(j+1)+\" → \"+(j+2)+(last.swap?\"，交换\":\"，保持\");\n j++;render();save();\n}\ndocument.getElementById(\"step\").onclick=step;\ndocument.getElementById(\"auto\").onclick=function(){\n if(autoT){clearInterval(autoT);autoT=null;this.textContent=\"自动\";}\n else{this.textContent=\"暂停\";autoT=setInterval(step,450);}\n};\ndocument.getElementById(\"reset\").onclick=function(){if(autoT){clearInterval(autoT);autoT=null;document.getElementById(\"auto\").textContent=\"自动\";}reset();};\nreset();\n})();</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"quadratic-1\",\"title\":\"二次函数与抛物线\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>二次函数</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#b388ff}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:720px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\ncanvas{width:100%;height:auto;display:block;border-radius:10px;background:#0b101b}\n.g{display:grid;grid-template-columns:repeat(3,1fr);gap:10px;margin-top:12px}\n.r{display:flex;justify-content:space-between;font-size:.75rem;color:#9aa7c2}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.f{margin-top:10px;font-size:.82rem;line-height:1.6}\n</style></head><body><div class=\"w\">\n<h1>二次函数 y = ax² + bx + c</h1>\n<p class=\"s\">顶点 x=−b/(2a)；判别式 Δ=b²−4ac 决定与 x 轴交点个数；a>0 开口向上。</p>\n<canvas id=\"cv\" width=\"720\" height=\"300\"></canvas>\n<div class=\"g\">\n <div><div class=\"r\"><span>a</span><span id=\"oa\">1.0</span></div><input id=\"a\" type=\"range\" min=\"-2\" max=\"2\" step=\"0.1\" value=\"1\" aria-label=\"a\"></div>\n <div><div class=\"r\"><span>b</span><span id=\"ob\">0.0</span></div><input id=\"b\" type=\"range\" min=\"-5\" max=\"5\" step=\"0.2\" value=\"0\" aria-label=\"b\"></div>\n <div><div class=\"r\"><span>c</span><span id=\"oc\">0.0</span></div><input id=\"c\" type=\"range\" min=\"-5\" max=\"5\" step=\"0.2\" value=\"0\" aria-label=\"c\"></div>\n</div>\n<p class=\"f\" id=\"info\"></p>\n</div>\n<script>(function(){\nvar D={a:1,b:0,c:0},S=Object.assign({},D);\ntry{if(genui&&genui.getState){var g=genui.getState();if(g&&typeof g===\"object\"){[\"a\",\"b\",\"c\"].forEach(function(k){if(isFinite(+g[k]))S[k]=+g[k]});}}}catch(e){}\nvar cv=document.getElementById(\"cv\"),ctx=cv.getContext(\"2d\");\nvar aE=document.getElementById(\"a\"),bE=document.getElementById(\"b\"),cE=document.getElementById(\"c\");\nvar oa=document.getElementById(\"oa\"),ob=document.getElementById(\"ob\"),oc=document.getElementById(\"oc\"),info=document.getElementById(\"info\");\nfunction save(){try{genui.setState(S)}catch(e){}}\nfunction draw(){\n var W=cv.width,H=cv.height,cx=W/2,cy=H/2,sx=W/20,sy=H/16;\n ctx.clearRect(0,0,W,H);ctx.strokeStyle=\"#1c2538\";ctx.beginPath();\n for(var i=-10;i<=10;i++){var x=cx+i*sx,y=cy+i*sy;ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.moveTo(0,y);ctx.lineTo(W,y)}ctx.stroke();\n ctx.strokeStyle=\"#3a4a6b\";ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(0,cy);ctx.lineTo(W,cy);ctx.moveTo(cx,0);ctx.lineTo(cx,H);ctx.stroke();\n ctx.strokeStyle=getComputedStyle(document.body).getPropertyValue(\"--accent\");ctx.lineWidth=2.4;ctx.beginPath();\n for(var px=0;px<=W;px++){var xx=(px-cx)/sx;if(xx<-10||xx>10)continue;var yy=S.a*xx*xx+S.b*xx+S.c;var py=cy-yy*sy;if(py<-50||py>H+50){continue}px?ctx.lineTo(px,py):ctx.moveTo(px,py)}ctx.stroke();\n}\nfunction ui(){\n oa.textContent=S.a.toFixed(1);ob.textContent=S.b.toFixed(1);oc.textContent=S.c.toFixed(1);\n aE.value=S.a;bE.value=S.b;cE.value=S.c;\n var d=S.b*S.b-4*S.a*S.c,info_txt=\"Δ = \"+d.toFixed(2)+\"  \";\n if(Math.abs(S.a)<1e-9)info_txt+=\"（a≈0 退化为一次函数）\";\n else{var vx=-S.b/(2*S.a),vy=S.a*vx*vx+S.b*vx+S.c;info_txt+=\"顶点 (\"+vx.toFixed(2)+\", \"+vy.toFixed(2)+\")，\"+(d>1e-9?\"两个实根\":d<-1e-9?\"无实根\":\"一个实根\");}\n info.textContent=info_txt;draw();\n}\n[\"a\",\"b\",\"c\"].forEach(function(k){document.getElementById(k).oninput=function(){S[k]=+this.value;ui();save()}});\nui();\n})();</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"linear-1\",\"title\":\"一次函数斜率与截距\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>一次函数</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#ff8a65}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:720px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\ncanvas{width:100%;height:auto;display:block;border-radius:10px;background:#0b101b}\n.c{margin-top:10px}.r{display:flex;justify-content:space-between;font-size:.78rem;color:#9aa7c2;margin-bottom:4px}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.f{margin-top:10px;font-size:.82rem;line-height:1.6;color:#9aa7c2}\n</style></head><body><div class=\"w\">\n<h1>一次函数 y = kx + b</h1>\n<p class=\"s\">k 为斜率（陡缓与方向），b 为 y 轴截距（直线与 y 轴交点）。</p>\n<canvas id=\"cv\" width=\"720\" height=\"320\"></canvas>\n<div class=\"c\"><div class=\"r\"><span>斜率 k</span><span id=\"ok\">1.0</span></div><input id=\"k\" type=\"range\" min=\"-3\" max=\"3\" step=\"0.1\" value=\"1\" aria-label=\"斜率\"></div>\n<div class=\"c\"><div class=\"r\"><span>截距 b</span><span id=\"ob\">0.0</span></div><input id=\"b\" type=\"range\" min=\"-4\" max=\"4\" step=\"0.2\" value=\"0\" aria-label=\"截距\"></div>\n<p class=\"f\" id=\"info\"></p>\n</div>\n<script>(function(){\nvar D={k:1,b:0},S=Object.assign({},D);\ntry{if(genui&&genui.getState){var g=genui.getState();if(g&&typeof g===\"object\"){if(isFinite(+g.k))S.k=+g.k;if(isFinite(+g.b))S.b=+g.b;}}}catch(e){}\nvar cv=document.getElementById(\"cv\"),ctx=cv.getContext(\"2d\");\nvar kE=document.getElementById(\"k\"),bE=document.getElementById(\"b\");\nvar ok=document.getElementById(\"ok\"),ob=document.getElementById(\"ob\"),info=document.getElementById(\"info\");\nfunction save(){try{genui.setState(S)}catch(e){}}\nfunction draw(){\n var W=cv.width,H=cv.height,cx=W/2,cy=H/2,sx=W/16,sy=H/12;\n ctx.clearRect(0,0,W,H);ctx.strokeStyle=\"#1c2538\";ctx.beginPath();\n for(var i=-8;i<=8;i++){var x=cx+i*sx,y=cy+i*sy;ctx.moveTo(x,0);ctx.lineTo(x,H);ctx.moveTo(0,y);ctx.lineTo(W,y)}ctx.stroke();\n ctx.strokeStyle=\"#3a4a6b\";ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(0,cy);ctx.lineTo(W,cy);ctx.moveTo(cx,0);ctx.lineTo(cx,H);ctx.stroke();\n var col=getComputedStyle(document.body).getPropertyValue(\"--accent\");\n ctx.strokeStyle=col;ctx.lineWidth=2.4;ctx.beginPath();\n var xL=-8,xR=8;var yL=S.k*xL+S.b,yR=S.k*xR+S.b;\n var px1=cx+xL*sx,py1=cy-yL*sy,px2=cx+xR*sx,py2=cy-yR*sy;\n ctx.moveTo(px1,py1);ctx.lineTo(px2,py2);ctx.stroke();\n // y-intercept marker\n ctx.fillStyle=col;ctx.beginPath();ctx.arc(cx,cy-S.b*sy,5,0,Math.PI*2);ctx.fill();\n ctx.fillStyle=getComputedStyle(document.body).getPropertyValue(\"--fg\");ctx.font=\"12px system-ui\";ctx.textAlign=\"left\";\n ctx.fillText(\"(0, \"+S.b.toFixed(1)+\")\",cx+8,cy-S.b*sy-8);\n}\nfunction ui(){\n ok.textContent=S.k.toFixed(1);ob.textContent=S.b.toFixed(1);kE.value=S.k;bE.value=S.b;\n var ang=Math.atan(S.k)*180/Math.PI;\n var dir=S.k>0.05?\"上升\":S.k<-0.05?\"下降\":\"水平\";\n info.textContent=\"斜率 k = \"+S.k.toFixed(1)+\"（倾角 \"+ang.toFixed(1)+\"°，\"+dir+\"），截距 b = \"+S.b.toFixed(1)+\"；x 每增加 1，y 变化 \"+S.k.toFixed(1)+\"。\";\n draw();\n}\nkE.oninput=function(){S.k=+this.value;ui();save()};\nbE.oninput=function(){S.b=+this.value;ui();save()};\nui();\n})();</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"projectile-1\",\"title\":\"抛体运动\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>抛体运动</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#4fc3f7}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:760px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\ncanvas{width:100%;height:auto;display:block;border-radius:10px;background:#0b101b}\n.c{margin-top:10px}.r{display:flex;justify-content:space-between;font-size:.78rem;color:#9aa7c2;margin-bottom:4px}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.f{margin-top:8px;font-size:.82rem;line-height:1.6;color:#9aa7c2}\n</style></head><body><div class=\"w\">\n<h1>抛体运动（无空气阻力，g=9.8 m/s²）</h1>\n<p class=\"s\">从地面以初速 v₀、仰角 θ 抛出：射程 R=v₀²sin2θ/g，最大高度 H=v₀²sin²θ/(2g)，飞行时间 T=2v₀sinθ/g。</p>\n<canvas id=\"cv\" width=\"720\" height=\"320\"></canvas>\n<div class=\"c\"><div class=\"r\"><span>初速度 v₀ (m/s)</span><span id=\"ov\">20.0</span></div><input id=\"v\" type=\"range\" min=\"5\" max=\"40\" step=\"0.5\" value=\"20\" aria-label=\"初速度\"></div>\n<div class=\"c\"><div class=\"r\"><span>仰角 θ (°)</span><span id=\"ot\">45</span></div><input id=\"t\" type=\"range\" min=\"5\" max=\"85\" step=\"1\" value=\"45\" aria-label=\"仰角\"></div>\n<p class=\"f\" id=\"info\"></p>\n</div>\n<script>(function(){\nvar D={v:20,t:45},S=Object.assign({},D);\ntry{if(genui&&genui.getState){var g=genui.getState();if(g&&typeof g===\"object\"){if(isFinite(+g.v))S.v=Math.min(40,Math.max(5,+g.v));if(isFinite(+g.t))S.t=Math.min(85,Math.max(5,+g.t));}}}catch(e){}\nvar G=9.8,cv=document.getElementById(\"cv\"),ctx=cv.getContext(\"2d\");\nvar vE=document.getElementById(\"v\"),tE=document.getElementById(\"t\");\nvar ov=document.getElementById(\"ov\"),ot=document.getElementById(\"ot\"),info=document.getElementById(\"info\");\nfunction save(){try{genui.setState(S)}catch(e){}}\nfunction draw(){\n var W=cv.width,H=cv.height,pad=30;\n var th=S.t*Math.PI/180,vx=S.v*Math.cos(th),vy0=S.v*Math.sin(th);\n var T=2*vy0/G,R=vx*T,Hm=vy0*vy0/(2*G);\n var scaleX=(W-pad*2)/Math.max(R,1),scaleY=(H-pad*2)/Math.max(Hm,1);\n var sc=Math.min(scaleX,scaleY);\n ctx.clearRect(0,0,W,H);\n ctx.strokeStyle=\"#3a4a6b\";ctx.lineWidth=2;ctx.beginPath();ctx.moveTo(pad,H-pad);ctx.lineTo(W-pad,H-pad);ctx.stroke();\n ctx.strokeStyle=\"#1c2538\";ctx.beginPath();\n for(var i=0;i<=10;i++){var x=pad+i*(W-pad*2)/10;ctx.moveTo(x,H-pad);ctx.lineTo(x,H-pad+6)}ctx.stroke();\n var col=getComputedStyle(document.body).getPropertyValue(\"--accent\");\n ctx.strokeStyle=col;ctx.lineWidth=2.4;ctx.beginPath();\n var N=100;for(var i=0;i<=N;i++){var tt=T*i/N;var x=pad+vx*tt*sc;var y=H-pad-(vy0*tt-0.5*G*tt*tt)*sc;i?ctx.lineTo(x,y):ctx.moveTo(x,y)}ctx.stroke();\n ctx.fillStyle=col;ctx.beginPath();ctx.arc(pad,H-pad,5,0,Math.PI*2);ctx.fill();\n ctx.fillStyle=getComputedStyle(document.body).getPropertyValue(\"--fg\");ctx.font=\"12px system-ui\";ctx.textAlign=\"left\";\n ctx.fillText(\"R=\"+R.toFixed(1)+\"m\",pad+4,H-pad-6);\n ctx.fillText(\"H=\"+Hm.toFixed(1)+\"m\",pad+4,pad+14);\n}\nfunction ui(){ov.textContent=S.v.toFixed(1);ot.textContent=S.t.toFixed(0);vE.value=S.v;tE.value=S.t;\n var th=S.t*Math.PI/180,vx=S.v*Math.cos(th),vy0=S.v*Math.sin(th);\n var T=2*vy0/G,R=vx*T,Hm=vy0*vy0/(2*G);\n info.textContent=\"射程 R = \"+R.toFixed(1)+\" m，最大高度 H = \"+Hm.toFixed(1)+\" m，飞行时间 T = \"+T.toFixed(2)+\" s。\";\n draw();}\nvE.oninput=function(){S.v=+this.value;ui();save()};\ntE.oninput=function(){S.t=+this.value;ui();save()};\nui();\n})();</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"ohm-1\",\"title\":\"欧姆定律\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>欧姆定律</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#ffb74d}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:720px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\ncanvas{width:100%;height:auto;display:block;border-radius:10px;background:#0b101b}\n.c{margin-top:10px}.r{display:flex;justify-content:space-between;font-size:.78rem;color:#9aa7c2;margin-bottom:4px}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.f{margin-top:8px;font-size:.82rem;line-height:1.6;color:#9aa7c2}\n</style></head><body><div class=\"w\">\n<h1>欧姆定律 I = U / R</h1>\n<p class=\"s\">电流与电压成正比、与电阻成反比。下方曲线为 I–U 关系（固定电阻 R）。</p>\n<canvas id=\"cv\" width=\"720\" height=\"300\"></canvas>\n<div class=\"c\"><div class=\"r\"><span>电压 U (V)</span><span id=\"ou\">6.0</span></div><input id=\"u\" type=\"range\" min=\"1\" max=\"24\" step=\"0.5\" value=\"6\" aria-label=\"电压\"></div>\n<div class=\"c\"><div class=\"r\"><span>电阻 R (Ω)</span><span id=\"or\">10</span></div><input id=\"r\" type=\"range\" min=\"1\" max=\"50\" step=\"1\" value=\"10\" aria-label=\"电阻\"></div>\n<p class=\"f\" id=\"info\"></p>\n</div>\n<script>(function(){\nvar D={u:6,r:10},S=Object.assign({},D);\ntry{if(genui&&genui.getState){var g=genui.getState();if(g&&typeof g===\"object\"){if(isFinite(+g.u))S.u=Math.min(24,Math.max(1,+g.u));if(isFinite(+g.r))S.r=Math.min(50,Math.max(1,+g.r));}}}catch(e){}\nvar cv=document.getElementById(\"cv\"),ctx=cv.getContext(\"2d\");\nvar uE=document.getElementById(\"u\"),rE=document.getElementById(\"r\");\nvar ou=document.getElementById(\"ou\"),or=document.getElementById(\"or\"),info=document.getElementById(\"info\");\nfunction save(){try{genui.setState(S)}catch(e){}}\nfunction draw(){\n var W=cv.width,H=cv.height,pad=35;\n ctx.clearRect(0,0,W,H);\n ctx.strokeStyle=\"#3a4a6b\";ctx.lineWidth=2;ctx.beginPath();\n ctx.moveTo(pad,pad);ctx.lineTo(pad,H-pad);ctx.lineTo(W-pad,H-pad);ctx.stroke();\n ctx.strokeStyle=\"#1c2538\";ctx.beginPath();\n for(var i=0;i<=5;i++){var y=pad+i*(H-pad*2)/5;ctx.moveTo(pad,y);ctx.lineTo(W-pad,y)}\n for(var i=0;i<=6;i++){var x=pad+i*(W-pad*2)/6;ctx.moveTo(x,pad);ctx.lineTo(x,H-pad)}ctx.stroke();\n var maxU=24,Imax=2;var maxI=maxU/S.r;\n var col=getComputedStyle(document.body).getPropertyValue(\"--accent\");\n ctx.strokeStyle=col;ctx.lineWidth=2.4;ctx.beginPath();\n var x0=pad,y0=H-pad;\n var x1=pad+(W-pad*2)*1.0, y1=H-pad-(H-pad*2)*Math.min(1,maxI/Imax);\n ctx.moveTo(x0,y0);ctx.lineTo(x1,y1);ctx.stroke();\n var px=pad+(W-pad*2)*(S.u/maxU),py=H-pad-(H-pad*2)*(S.u/S.r/Imax);\n if(py<pad)py=pad;\n ctx.fillStyle=col;ctx.beginPath();ctx.arc(px,py,5,0,Math.PI*2);ctx.fill();\n ctx.fillStyle=getComputedStyle(document.body).getPropertyValue(\"--fg\");ctx.font=\"11px system-ui\";ctx.textAlign=\"left\";\n ctx.fillText(\"I (A)\",pad+4,pad-4);ctx.fillText(\"U (V)\",W-pad-10,H-pad+18);\n ctx.textAlign=\"center\";ctx.fillText(\"0\",pad,H-pad+16);\n}\nfunction ui(){ou.textContent=S.u.toFixed(1);or.textContent=S.r.toFixed(0);uE.value=S.u;rE.value=S.r;\n var I=S.u/S.r,P=S.u*I;\n info.textContent=\"电流 I = U/R = \"+I.toFixed(2)+\" A，功率 P = UI = \"+P.toFixed(1)+\" W。\";\n draw();}\nuE.oninput=function(){S.u=+this.value;ui();save()};\nrE.oninput=function(){S.r=+this.value;ui();save()};\nui();\n})();</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"rgb-1\",\"title\":\"RGB三原色混合\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>RGB混合</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#7ee081}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:720px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\n#out{height:120px;border-radius:10px;border:1px solid #2a3550;margin-bottom:10px;transition:background .15s}\n.c{margin-top:8px}.r{display:flex;justify-content:space-between;font-size:.78rem;color:#9aa7c2;margin-bottom:3px}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.f{margin-top:8px;font-size:.85rem;font-family:ui-monospace,monospace}\n</style></head><body><div class=\"w\">\n<h1>RGB 三原色加色混合</h1>\n<p class=\"s\">红、绿、蓝通道值线性叠加，叠加处混合出黄、青、品红与白色。</p>\n<div id=\"out\"></div>\n<div class=\"c\"><div class=\"r\"><span>红 R</span><span id=\"orr\">128</span></div><input id=\"r\" type=\"range\" min=\"0\" max=\"255\" step=\"1\" value=\"128\" aria-label=\"红通道\"></div>\n<div class=\"c\"><div class=\"r\"><span>绿 G</span><span id=\"og\">128</span></div><input id=\"g\" type=\"range\" min=\"0\" max=\"255\" step=\"1\" value=\"128\" aria-label=\"绿通道\"></div>\n<div class=\"c\"><div class=\"r\"><span>蓝 B</span><span id=\"ob\">128</span></div><input id=\"b\" type=\"range\" min=\"0\" max=\"255\" step=\"1\" value=\"128\" aria-label=\"蓝通道\"></div>\n<p class=\"f\" id=\"info\"></p>\n</div>\n<script>(function(){\nvar D={r:128,g:128,b:128},S=Object.assign({},D);\ntry{if(genui&&genui.getState){var g=genui.getState();if(g&&typeof g===\"object\"){[\"r\",\"g\",\"b\"].forEach(function(k){if(isFinite(+g[k]))S[k]=Math.min(255,Math.max(0,Math.round(+g[k])))});}}}catch(e){}\nvar out=document.getElementById(\"out\"),info=document.getElementById(\"info\");\nvar o={r:document.getElementById(\"orr\"),g:document.getElementById(\"og\"),b:document.getElementById(\"ob\")};\nfunction save(){try{genui.setState(S)}catch(e){}}\nfunction hex(v){return(\"0\"+v.toString(16)).slice(-2).toUpperCase()}\nfunction ui(){\n out.style.background=\"rgb(\"+S.r+\",\"+S.g+\",\"+S.b+\")\";\n o.r.textContent=S.r;o.g.textContent=S.g;o.b.textContent=S.b;\n document.getElementById(\"r\").value=S.r;document.getElementById(\"g\").value=S.g;document.getElementById(\"b\").value=S.b;\n info.textContent=\"#\"+hex(S.r)+hex(S.g)+hex(S.b)+\"  rgb(\"+S.r+\", \"+S.g+\", \"+S.b+\")\";\n}\n[\"r\",\"g\",\"b\"].forEach(function(k){document.getElementById(k).oninput=function(){S[k]=+this.value;ui();save()}});\nui();\n})();</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"rectangle-1\",\"title\":\"矩形长宽与面积周长\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>矩形</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#b388ff}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:720px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\ncanvas{width:100%;height:auto;display:block;border-radius:10px;background:#0b101b}\n.c{margin-top:10px}.r{display:flex;justify-content:space-between;font-size:.78rem;color:#9aa7c2;margin-bottom:4px}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.f{margin-top:8px;font-size:.9rem;line-height:1.7}\n</style></head><body><div class=\"w\">\n<h1>矩形的面积与周长</h1>\n<p class=\"s\">面积 A = 长 × 宽；周长 P = 2(长 + 宽)。</p>\n<canvas id=\"cv\" width=\"720\" height=\"280\"></canvas>\n<div class=\"c\"><div class=\"r\"><span>长 l</span><span id=\"ol\">6.0</span></div><input id=\"l\" type=\"range\" min=\"1\" max=\"10\" step=\"0.1\" value=\"6\" aria-label=\"长\"></div>\n<div class=\"c\"><div class=\"r\"><span>宽 w</span><span id=\"ow\">4.0</span></div><input id=\"w\" type=\"range\" min=\"1\" max=\"10\" step=\"0.1\" value=\"4\" aria-label=\"宽\"></div>\n<p class=\"f\" id=\"info\"></p>\n</div>\n<script>(function(){\nvar D={l:6,w:4},S=Object.assign({},D);\ntry{if(genui&&genui.getState){var g=genui.getState();if(g&&typeof g===\"object\"){[\"l\",\"w\"].forEach(function(k){if(isFinite(+g[k]))S[k]=Math.min(10,Math.max(1,+g[k]))});}}}catch(e){}\nvar cv=document.getElementById(\"cv\"),ctx=cv.getContext(\"2d\");\nvar o={l:document.getElementById(\"ol\"),w:document.getElementById(\"ow\")},info=document.getElementById(\"info\");\nfunction save(){try{genui.setState(S)}catch(e){}}\nfunction draw(){\n var W=cv.width,H=cv.height,pad=40;\n var maxDim=10,sc=Math.min((W-pad*2)/maxDim,(H-pad*2)/maxDim);\n var rw=S.l*sc,rh=S.w*sc,rx=(W-rw)/2,ry=(H-rh)/2;\n ctx.clearRect(0,0,W,H);\n var col=getComputedStyle(document.body).getPropertyValue(\"--accent\");\n ctx.fillStyle=\"rgba(179,136,255,.18)\";ctx.fillRect(rx,ry,rw,rh);\n ctx.strokeStyle=col;ctx.lineWidth=2.4;ctx.strokeRect(rx,ry,rw,rh);\n ctx.fillStyle=getComputedStyle(document.body).getPropertyValue(\"--fg\");ctx.font=\"12px system-ui\";ctx.textAlign=\"center\";\n ctx.fillText(S.l.toFixed(1),rx+rw/2,ry-6);\n ctx.textAlign=\"left\";ctx.fillText(S.w.toFixed(1),rx+rw+6,ry+rh/2);\n}\nfunction ui(){o.l.textContent=S.l.toFixed(1);o.w.textContent=S.w.toFixed(1);\n document.getElementById(\"l\").value=S.l;document.getElementById(\"w\").value=S.w;\n info.innerHTML=\"面积 A = \"+S.l.toFixed(1)+\" × \"+S.w.toFixed(1)+\" = <b>\"+(S.l*S.w).toFixed(2)+\"</b><br>周长 P = 2(\"+S.l.toFixed(1)+\" + \"+S.w.toFixed(1)+\") = <b>\"+(2*(S.l+S.w)).toFixed(2)+\"</b>\";\n draw();}\n[\"l\",\"w\"].forEach(function(k){document.getElementById(k).oninput=function(){S[k]=+this.value;ui();save()}});\nui();\n})();</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"coin-1\",\"title\":\"硬币投掷二项概率\",\"stateVersion\":1} -->\n<!DOCTYPE html><html lang=\"zh-CN\"><head><meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>硬币概率</title>\n<style>\n:root{--bg:#0f1420;--fg:#e8edf7;--accent:#ff8a65}\nbody{margin:0;padding:14px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif}\n.w{max-width:720px;margin:auto}h1{font-size:1.1rem;margin:0 0 6px}\np.s{font-size:.8rem;color:#9aa7c2;margin:0 0 12px;line-height:1.5}\ncanvas{width:100%;height:auto;display:block;border-radius:10px;background:#0b101b}\n.c{margin-top:10px}.r{display:flex;justify-content:space-between;font-size:.78rem;color:#9aa7c2;margin-bottom:4px}\ninput[type=range]{width:100%;accent-color:var(--accent)}\n.f{margin-top:8px;font-size:.88rem;line-height:1.7}\n</style></head><body><div class=\"w\">\n<h1>硬币投掷：恰好 k 次正面</h1>\n<p class=\"s\">n 次独立公平投掷，正面次数 X~B(n, 0.5)，P(X=k)=C(n,k)/2ⁿ。</p>\n<canvas id=\"cv\" width=\"720\" height=\"240\"></canvas>\n<div class=\"c\"><div class=\"r\"><span>投掷次数 n</span><span id=\"on\">10</span></div><input id=\"n\" type=\"range\" min=\"1\" max=\"20\" step=\"1\" value=\"10\" aria-label=\"投掷次数\"></div>\n<div class=\"c\"><div class=\"r\"><span>正面次数 k</span><span id=\"ok\">5</span></div><input id=\"k\" type=\"range\" min=\"0\" max=\"10\" step=\"1\" value=\"5\" aria-label=\"正面次数\"></div>\n<p class=\"f\" id=\"info\"></p>\n</div>\n<script>(function(){\nvar D={n:10,k:5},S=Object.assign({},D);\ntry{if(genui&&genui.getState){var g=genui.getState();if(g&&typeof g===\"object\"){if(isFinite(+g.n))S.n=Math.min(20,Math.max(1,Math.round(+g.n)));if(isFinite(+g.k))S.k=Math.max(0,Math.round(+g.k));}}}catch(e){}\nif(S.k>S.n)S.k=S.n;\nvar cv=document.getElementById(\"cv\"),ctx=cv.getContext(\"2d\");\nvar nE=document.getElementById(\"n\"),kE=document.getElementById(\"k\");\nvar on=document.getElementById(\"on\"),ok=document.getElementById(\"ok\"),info=document.getElementById(\"info\");\nfunction save(){try{genui.setState(S)}catch(e){}}\nfunction comb(n,k){if(k<0||k>n)return 0;var r=1;for(var i=1;i<=k;i++)r=r*(n-k+i)/i;return Math.round(r)}\nfunction probs(n){var out=[],tot=Math.pow(2,n);for(var k=0;k<=n;k++)out.push(comb(n,k)/tot);return out}\nfunction draw(){\n var W=cv.width,H=cv.height,pad=28;\n var P=probs(S.n),maxP=Math.max.apply(null,P)||1;\n var bw=(W-pad*2)/(S.n+1);\n ctx.clearRect(0,0,W,H);\n ctx.strokeStyle=\"#3a4a6b\";ctx.lineWidth=1.5;ctx.beginPath();ctx.moveTo(pad,H-pad);ctx.lineTo(W-pad,H-pad);ctx.stroke();\n var col=getComputedStyle(document.body).getPropertyValue(\"--accent\");\n for(var k=0;k<=S.n;k++){\n  var h=(P[k]/maxP)*(H-pad*2-14),x=pad+k*bw+bw*0.15,w=bw*0.7,y=H-pad-h;\n  ctx.fillStyle=(k===S.k)?col:\"#2a3550\";\n  ctx.fillRect(x,y,w,h);\n }\n ctx.fillStyle=getComputedStyle(document.body).getPropertyValue(\"--fg\");ctx.font=\"11px system-ui\";ctx.textAlign=\"center\";\n for(var k=0;k<=S.n;k++){if(S.n>12&&k%2)continue;ctx.fillText(k,pad+k*bw+bw/2,H-pad+14)}\n}\nfunction ui(){\n if(S.k>S.n)S.k=S.n;\n nE.value=S.n;kE.max=S.n;kE.value=S.k;\n on.textContent=S.n;ok.textContent=S.k;\n var P=probs(S.n),p=P[S.k];\n info.innerHTML=\"P(X = \"+S.k+\") = C(\"+S.n+\",\"+S.k+\")/2<sup>\"+S.n+\"</sup> = \"+comb(S.n,S.k)+\" / \"+Math.pow(2,S.n)+\" ≈ <b>\"+(p*100).toFixed(2)+\"%</b>\";\n draw();\n}\nnE.oninput=function(){S.n=+this.value;if(S.k>S.n)S.k=S.n;ui();save()};\nkE.oninput=function(){S.k=+this.value;ui();save()};\nui();\n})();</script></body></html>"
