{
  "sources": [
    "<!-- more-genui: {\"version\":1,\"id\":\"wave-2\",\"title\":\"正弦波振幅与频率\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">🌊 正弦波 · 振幅与频率</h2>\n<p style=\"font-size:13px;opacity:0.75;\">y(t) = A·sin(2πf·t)，t∈[0,2]s。振幅A拉伸波峰，频率f压缩周期。</p>\n<canvas id=\"c\" width=\"520\" height=\"220\" style=\"width:100%;background:#0e1c2c;border-radius:12px;\"></canvas>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">振幅 A <output id=\"av\">1.00</output></label>\n<input id=\"a\" type=\"range\" min=\"0.2\" max=\"2\" step=\"0.01\" value=\"1\" style=\"width:100%;\"></div>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">频率 f (Hz) <output id=\"fv\">1.00</output></label>\n<input id=\"f\" type=\"range\" min=\"0.5\" max=\"4\" step=\"0.01\" value=\"1\" style=\"width:100%;\"></div>\n</div>\n<script>\nconst c=document.getElementById('c'),ctx=c.getContext('2d'),a=document.getElementById('a'),f=document.getElementById('f');\nconst st=genui.getState();if(st.amp!=null)a.value=st.amp;if(st.freq!=null)f.value=st.freq;\nfunction draw(){const w=c.width,h=c.height,A=+a.value,F=+f.value;document.getElementById('av').textContent=A.toFixed(2);document.getElementById('fv').textContent=F.toFixed(2);\nctx.clearRect(0,0,w,h);ctx.strokeStyle='#3f5f7a';ctx.beginPath();ctx.moveTo(0,h/2);ctx.lineTo(w,h/2);ctx.stroke();\nctx.beginPath();ctx.strokeStyle='var(--accent)';ctx.lineWidth=2.5;\nfor(let i=0;i<=600;i++){const t=i/600*2,x=i/600*w,y=A*Math.sin(2*Math.PI*F*t);const py=h/2-(y/2.2)*(h/2)*0.9;i?ctx.lineTo(x,py):ctx.moveTo(x,py);}\nctx.stroke();genui.setState({amp:A,freq:F});}\na.oninput=draw;f.oninput=draw;draw();\n</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"spring-2\",\"title\":\"理想弹簧振子\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">🌀 理想弹簧振子 (m=1kg)</h2>\n<p style=\"font-size:13px;opacity:0.75;\">x(t) = x₀·cos(ωt)，ω=√(k/m)。假设无阻尼、初位移x₀=1m、初速度0。</p>\n<canvas id=\"c\" width=\"520\" height=\"200\" style=\"width:100%;background:#0e1c2c;border-radius:12px;\"></canvas>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">刚度 k (N/m) <output id=\"kv\">4.00</output></label>\n<input id=\"k\" type=\"range\" min=\"1\" max=\"20\" step=\"0.1\" value=\"4\" style=\"width:100%;\"></div>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">时间 t (s) <output id=\"tv\">0.00</output></label>\n<input id=\"t\" type=\"range\" min=\"0\" max=\"10\" step=\"0.01\" value=\"0\" style=\"width:100%;\"></div>\n</div>\n<script>\nconst c=document.getElementById('c'),ctx=c.getContext('2d'),k=document.getElementById('k'),tS=document.getElementById('t');\nconst st=genui.getState();if(st.k!=null)k.value=st.k;if(st.t!=null)tS.value=st.t;\nfunction draw(){const w=c.width,h=c.height,K=+k.value,T=+tS.value;document.getElementById('kv').textContent=K.toFixed(2);document.getElementById('tv').textContent=T.toFixed(2);\nctx.clearRect(0,0,w,h);ctx.strokeStyle='#3f5f7a';ctx.beginPath();ctx.moveTo(0,h/2);ctx.lineTo(w,h/2);ctx.stroke();\nconst omega=Math.sqrt(K);ctx.beginPath();ctx.strokeStyle='var(--accent)';ctx.lineWidth=2;\nfor(let i=0;i<=500;i++){const tt=i/500*10,x=Math.cos(omega*tt);const px=i/500*w,py=h/2-(x/1.5)*(h/2)*0.8;i?ctx.lineTo(px,py):ctx.moveTo(px,py);}\nctx.stroke();\nconst curX=Math.cos(omega*T);const cx=(T/10)*w,cy=h/2-(curX/1.5)*(h/2)*0.8;\nctx.beginPath();ctx.arc(cx,cy,7,0,2*Math.PI);ctx.fillStyle='#ffd966';ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.stroke();\ngenui.setState({k:K,t:T});}\nk.oninput=draw;tS.oninput=draw;draw();\n</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"sort-2\",\"title\":\"冒泡排序逐步演示\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">🔁 冒泡排序逐步演示</h2>\n<p style=\"font-size:13px;opacity:0.75;\">重复扫描相邻元素，逆序则交换。每轮把最大元素\"冒泡\"到末尾。</p>\n<div id=\"bars\" style=\"display:flex;align-items:flex-end;gap:6px;height:180px;background:#0e1c2c;padding:12px;border-radius:12px;\"></div>\n<div style=\"margin-top:12px;display:flex;gap:8px;flex-wrap:wrap;\">\n<button id=\"step\" style=\"padding:8px 16px;background:var(--accent);color:#000;border:none;border-radius:8px;font-weight:600;cursor:pointer;\">单步 ▶</button>\n<button id=\"reset\" style=\"padding:8px 16px;background:#3f5f7a;color:var(--fg);border:none;border-radius:8px;cursor:pointer;\">重置 ⟲</button>\n</div>\n<p id=\"status\" style=\"font-size:13px;margin-top:8px;color:var(--accent);\">已排序: 0 / 6</p>\n</div>\n<script>\nconst orig=[5,2,8,1,9,3];\nlet arr=[...orig],i=0,j=0,done=0,sorted=false;\nconst st=genui.getState();if(st.arr&&Array.isArray(st.arr)){arr=st.arr;i=st.i||0;j=st.j||0;done=st.done||0;sorted=st.sorted||false;}\nfunction render(){const b=document.getElementById('bars');b.innerHTML='';\nconst max=Math.max(...arr);arr.forEach((v,idx)=>{const d=document.createElement('div');\nd.style.cssText=`flex:1;height:${(v/max)*100}%;background:${idx>=arr.length-done?'#6bc9ff':(idx===j?'#ffd966':'#3f5f7a')};border-radius:6px 6px 0 0;transition:0.2s;display:flex;align-items:flex-start;justify-content:center;color:#fff;font-size:11px;padding-top:4px;`;\nd.textContent=v;b.appendChild(d);});\ndocument.getElementById('status').textContent=sorted?'✅ 排序完成！':`已排序: ${done} / 6 · 比较位置 j=${j}`;}\nfunction step(){if(sorted)return;if(j>=arr.length-1-done){done++;j=0;if(done>=arr.length-1){sorted=true;genui.setState({arr,i,j,done,sorted});render();return;}}\nif(arr[j]>arr[j+1])[arr[j],arr[j+1]]=[arr[j+1],arr[j]];j++;genui.setState({arr,i,j,done,sorted});render();}\ndocument.getElementById('step').onclick=step;\ndocument.getElementById('reset').onclick=()=>{arr=[...orig];i=0;j=0;done=0;sorted=false;genui.setState({arr,i,j,done,sorted});render();};\nrender();\n</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"quadratic-2\",\"title\":\"二次函数的a,b,c与抛物线\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">📐 二次函数 y = ax²+bx+c</h2>\n<p style=\"font-size:13px;opacity:0.75;\">a控制开口方向/宽窄，b影响对称轴位置，c是y轴截距。顶点 x = −b/(2a)。</p>\n<canvas id=\"c\" width=\"520\" height=\"240\" style=\"width:100%;background:#0e1c2c;border-radius:12px;\"></canvas>\n<div style=\"display:grid;grid-template-columns:1fr 1fr 1fr;gap:10px;margin-top:12px;\">\n<div><label style=\"font-size:12px;\">a <output id=\"av\">1.0</output></label><input id=\"a\" type=\"range\" min=\"-3\" max=\"3\" step=\"0.1\" value=\"1\" style=\"width:100%;\"></div>\n<div><label style=\"font-size:12px;\">b <output id=\"bv\">0.0</output></label><input id=\"b\" type=\"range\" min=\"-5\" max=\"5\" step=\"0.1\" value=\"0\" style=\"width:100%;\"></div>\n<div><label style=\"font-size:12px;\">c <output id=\"cv\">0.0</output></label><input id=\"c\" type=\"range\" min=\"-5\" max=\"5\" step=\"0.1\" value=\"0\" style=\"width:100%;\"></div>\n</div>\n</div>\n<script>\nconst c=document.getElementById('c'),ctx=c.getContext('2d'),sa=document.getElementById('a'),sb=document.getElementById('b'),sc=document.getElementById('c');\nconst st=genui.getState();if(st.a!=null)sa.value=st.a;if(st.b!=null)sb.value=st.b;if(st.c!=null)sc.value=st.c;\nfunction draw(){const w=c.width,h=c.height,A=+sa.value,B=+sb.value,C=+sc.value;\ndocument.getElementById('av').textContent=A.toFixed(1);document.getElementById('bv').textContent=B.toFixed(1);document.getElementById('cv').textContent=C.toFixed(1);\nctx.clearRect(0,0,w,h);ctx.strokeStyle='#3f5f7a';ctx.beginPath();ctx.moveTo(0,h/2);ctx.lineTo(w,h/2);ctx.moveTo(w/2,0);ctx.lineTo(w/2,h);ctx.stroke();\nconst sx=w/10,sy=h/10;ctx.beginPath();ctx.strokeStyle='var(--accent)';ctx.lineWidth=2.5;\nfor(let i=0;i<=w;i++){const x=(i-w/2)/sx,y=A*x*x+B*x+C;const py=h/2-y*sy;i?ctx.lineTo(i,py):ctx.moveTo(i,py);}\nctx.stroke();genui.setState({a:A,b:B,c:C});}\nsa.oninput=draw;sb.oninput=draw;sc.oninput=draw;draw();\n</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"linear-2\",\"title\":\"一次函数斜率与截距\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">📈 一次函数 y = kx + b</h2>\n<p style=\"font-size:13px;opacity:0.75;\">k是斜率（每单位x的y变化量），b是y轴截距（x=0时的y值）。</p>\n<canvas id=\"c\" width=\"520\" height=\"240\" style=\"width:100%;background:#0e1c2c;border-radius:12px;\"></canvas>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">斜率 k <output id=\"kv\">1.0</output></label>\n<input id=\"k\" type=\"range\" min=\"-3\" max=\"3\" step=\"0.1\" value=\"1\" style=\"width:100%;\"></div>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">截距 b <output id=\"bv\">0.0</output></label>\n<input id=\"b\" type=\"range\" min=\"-4\" max=\"4\" step=\"0.1\" value=\"0\" style=\"width:100%;\"></div>\n</div>\n<script>\nconst c=document.getElementById('c'),ctx=c.getContext('2d'),sk=document.getElementById('k'),sb=document.getElementById('b');\nconst st=genui.getState();if(st.k!=null)sk.value=st.k;if(st.b!=null)sb.value=st.b;\nfunction draw(){const w=c.width,h=c.height,K=+sk.value,B=+sb.value;\ndocument.getElementById('kv').textContent=K.toFixed(1);document.getElementById('bv').textContent=B.toFixed(1);\nctx.clearRect(0,0,w,h);ctx.strokeStyle='#3f5f7a';ctx.beginPath();ctx.moveTo(0,h/2);ctx.lineTo(w,h/2);ctx.moveTo(w/2,0);ctx.lineTo(w/2,h);ctx.stroke();\nconst sx=w/10,sy=h/10;ctx.beginPath();ctx.strokeStyle='var(--accent)';ctx.lineWidth=2.5;\nconst x1=-5,x2=5;const y1=K*x1+B,y2=K*x2+B;\nctx.moveTo(w/2+x1*sx,h/2-y1*sy);ctx.lineTo(w/2+x2*sx,h/2-y2*sy);ctx.stroke();\nctx.beginPath();ctx.arc(w/2,h/2-B*sy,7,0,2*Math.PI);ctx.fillStyle='#ffd966';ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.stroke();\ngenui.setState({k:K,b:B});}\nsk.oninput=draw;sb.oninput=draw;draw();\n</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"projectile-2\",\"title\":\"抛体运动·初速度与角度\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">🚀 无阻力抛体运动 (g=9.8)</h2>\n<p style=\"font-size:13px;opacity:0.75;\">x=v₀cosθ·t，y=v₀sinθ·t−½gt²。轨迹为抛物线，落回地面时 y=0。</p>\n<canvas id=\"c\" width=\"520\" height=\"240\" style=\"width:100%;background:#0e1c2c;border-radius:12px;\"></canvas>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">初速度 v₀ (m/s) <output id=\"vv\">20.0</output></label>\n<input id=\"v\" type=\"range\" min=\"5\" max=\"50\" step=\"0.5\" value=\"20\" style=\"width:100%;\"></div>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">角度 θ (°) <output id=\"tv\">45</output></label>\n<input id=\"t\" type=\"range\" min=\"5\" max=\"85\" step=\"1\" value=\"45\" style=\"width:100%;\"></div>\n<p id=\"info\" style=\"font-size:13px;margin-top:10px;color:var(--accent);\"></p>\n</div>\n<script>\nconst c=document.getElementById('c'),ctx=c.getContext('2d'),v=document.getElementById('v'),t=document.getElementById('t');\nconst st=genui.getState();if(st.v!=null)v.value=st.v;if(st.theta!=null)t.value=st.theta;\nfunction draw(){const w=c.width,h=c.height,V=+v.value,th=+t.value*Math.PI/180;\ndocument.getElementById('vv').textContent=V.toFixed(1);document.getElementById('tv').textContent=(+t.value).toFixed(0);\nconst vx=V*Math.cos(th),vy=V*Math.sin(th),g=9.8;\nconst tFlight=2*vy/g,range=vx*tFlight,maxH=vy*vy/(2*g);\nctx.clearRect(0,0,w,h);ctx.strokeStyle='#3f5f7a';ctx.beginPath();ctx.moveTo(0,h-20);ctx.lineTo(w,h-20);ctx.stroke();\nconst scaleX=(w-40)/Math.max(range,1),scaleY=(h-50)/Math.max(maxH*2,1);\nctx.beginPath();ctx.strokeStyle='var(--accent)';ctx.lineWidth=2.5;\nfor(let i=0;i<=200;i++){const tt=i/200*tFlight;const x=vx*tt,y=vy*tt-0.5*g*tt*tt;const px=20+x*scaleX,py=h-20-y*scaleY;i?ctx.lineTo(px,py):ctx.moveTo(px,py);}\nctx.stroke();\nctx.beginPath();ctx.arc(20+range*scaleX,h-20,6,0,2*Math.PI);ctx.fillStyle='#ffd966';ctx.fill();ctx.strokeStyle='#fff';ctx.lineWidth=2;ctx.stroke();\ndocument.getElementById('info').textContent=`射程 ${range.toFixed(1)}m · 最大高度 ${maxH.toFixed(1)}m · 飞行时间 ${tFlight.toFixed(2)}s`;\ngenui.setState({v:V,theta:+t.value});}\nv.oninput=draw;t.oninput=draw;draw();\n</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"ohm-2\",\"title\":\"欧姆定律·电压电阻与电流\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">⚡ 欧姆定律 I = U / R</h2>\n<p style=\"font-size:13px;opacity:0.75;\">理想电阻，温度恒定。电流与电压成正比，与电阻成反比。</p>\n<canvas id=\"c\" width=\"520\" height=\"200\" style=\"width:100%;background:#0e1c2c;border-radius:12px;\"></canvas>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">电压 U (V) <output id=\"uv\">12.0</output></label>\n<input id=\"u\" type=\"range\" min=\"0\" max=\"24\" step=\"0.1\" value=\"12\" style=\"width:100%;\"></div>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">电阻 R (Ω) <output id=\"rv\">6.0</output></label>\n<input id=\"r\" type=\"range\" min=\"0.5\" max=\"30\" step=\"0.5\" value=\"6\" style=\"width:100%;\"></div>\n<p id=\"info\" style=\"font-size:15px;margin-top:10px;color:var(--accent);font-weight:600;\"></p>\n</div>\n<script>\nconst c=document.getElementById('c'),ctx=c.getContext('2d'),u=document.getElementById('u'),r=document.getElementById('r');\nconst st=genui.getState();if(st.u!=null)u.value=st.u;if(st.r!=null)r.value=st.r;\nfunction draw(){const w=c.width,h=c.height,U=+u.value,R=+r.value,I=U/R;\ndocument.getElementById('uv').textContent=U.toFixed(1);document.getElementById('rv').textContent=R.toFixed(1);\nctx.clearRect(0,0,w,h);\nctx.beginPath();ctx.fillStyle='#1e334a';ctx.fillRect(0,0,w,h);\nconst cw=w-60,ch=h-60;const maxI=24/0.5;\nconst barW=cw*Math.min(I/maxI,1);\nctx.fillStyle='var(--accent)';ctx.fillRect(30,40,barW,ch);\nctx.strokeStyle='#3f5f7a';ctx.strokeRect(30,40,cw,ch);\nctx.fillStyle='#fff';ctx.font='bold 20px system-ui';ctx.textAlign='center';ctx.fillText(I.toFixed(2)+' A',w/2,35);\ndocument.getElementById('info').textContent=`电流 I = ${I.toFixed(2)} A`;\ngenui.setState({u:U,r:R});}\nu.oninput=draw;r.oninput=draw;draw();\n</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"rgb-2\",\"title\":\"RGB三原色混合\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">🎨 RGB 三原色混合</h2>\n<p style=\"font-size:13px;opacity:0.75;\">加色混合：R、G、B 亮度叠加形成颜色。rgb(r,g,b) 各通道 0–255。</p>\n<div id=\"swatch\" style=\"width:100%;height:180px;border-radius:12px;margin-top:8px;border:1px solid #3f5f7a;transition:0.15s;\"></div>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">R <output id=\"rv\">128</output></label><input id=\"r\" type=\"range\" min=\"0\" max=\"255\" value=\"128\" style=\"width:100%;accent-color:#ff5252;\"></div>\n<div style=\"margin-top:8px;\"><label style=\"display:flex;justify-content:space-between;\">G <output id=\"gv\">128</output></label><input id=\"g\" type=\"range\" min=\"0\" max=\"255\" value=\"128\" style=\"width:100%;accent-color:#52ff7a;\"></div>\n<div style=\"margin-top:8px;\"><label style=\"display:flex;justify-content:space-between;\">B <output id=\"bv\">128</output></label><input id=\"b\" type=\"range\" min=\"0\" max=\"255\" value=\"128\" style=\"width:100%;accent-color:#52a8ff;\"></div>\n<p id=\"info\" style=\"font-size:13px;margin-top:10px;color:var(--accent);\"></p>\n</div>\n<script>\nconst sw=document.getElementById('swatch'),r=document.getElementById('r'),g=document.getElementById('g'),b=document.getElementById('b');\nconst st=genui.getState();if(st.r!=null)r.value=st.r;if(st.g!=null)g.value=st.g;if(st.b!=null)b.value=st.b;\nfunction draw(){const R=+r.value,G=+g.value,B=+b.value;\ndocument.getElementById('rv').textContent=R;document.getElementById('gv').textContent=G;document.getElementById('bv').textContent=B;\nsw.style.background=`rgb(${R},${G},${B})`;\ndocument.getElementById('info').textContent=`rgb(${R}, ${G}, ${B}) · #${((1<<24)+(R<<16)+(G<<8)+B).toString(16).slice(1).toUpperCase()}`;\ngenui.setState({r:R,g:G,b:B});}\nr.oninput=draw;g.oninput=draw;b.oninput=draw;draw();\n</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"rectangle-2\",\"title\":\"矩形长宽与面积周长\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">▭ 矩形·面积与周长</h2>\n<p style=\"font-size:13px;opacity:0.75;\">面积 = 长×宽，周长 = 2×(长+宽)。图形按比例缩放显示。</p>\n<canvas id=\"c\" width=\"520\" height=\"240\" style=\"width:100%;background:#0e1c2c;border-radius:12px;\"></canvas>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">长 (m) <output id=\"lv\">6.0</output></label><input id=\"l\" type=\"range\" min=\"1\" max=\"15\" step=\"0.1\" value=\"6\" style=\"width:100%;\"></div>\n<div style=\"margin-top:8px;\"><label style=\"display:flex;justify-content:space-between;\">宽 (m) <output id=\"wv\">4.0</output></label><input id=\"w\" type=\"range\" min=\"1\" max=\"15\" step=\"0.1\" value=\"4\" style=\"width:100%;\"></div>\n<p id=\"info\" style=\"font-size:15px;margin-top:10px;color:var(--accent);font-weight:600;\"></p>\n</div>\n<script>\nconst c=document.getElementById('c'),ctx=c.getContext('2d'),l=document.getElementById('l'),w=document.getElementById('w');\nconst st=genui.getState();if(st.l!=null)l.value=st.l;if(st.w!=null)w.value=st.w;\nfunction draw(){const cw=c.width,ch=c.height,L=+l.value,W=+w.value;\ndocument.getElementById('lv').textContent=L.toFixed(1);document.getElementById('wv').textContent=W.toFixed(1);\nctx.clearRect(0,0,cw,ch);ctx.fillStyle='#0e1c2c';ctx.fillRect(0,0,cw,ch);\nconst maxDim=Math.max(L,W);const scale=Math.min((cw-80)/maxDim,(ch-60)/maxDim);\nconst pw=L*scale,ph=W*scale;const px=(cw-pw)/2,py=(ch-ph)/2;\nctx.fillStyle='rgba(107,201,255,0.25)';ctx.fillRect(px,py,pw,ph);\nctx.strokeStyle='var(--accent)';ctx.lineWidth=2.5;ctx.strokeRect(px,py,pw,ph);\nctx.fillStyle='#fff';ctx.font='bold 15px system-ui';ctx.textAlign='center';\nctx.fillText(`${L.toFixed(1)} m`,cw/2,py-8);\nctx.save();ctx.translate(px-12,py+ph/2);ctx.rotate(-Math.PI/2);ctx.fillText(`${W.toFixed(1)} m`,0,0);ctx.restore();\ndocument.getElementById('info').textContent=`面积 = ${(L*W).toFixed(2)} m² · 周长 = ${(2*(L+W)).toFixed(2)} m`;\ngenui.setState({l:L,w:W});}\nl.oninput=draw;w.oninput=draw;draw();\n</script></body></html>",
    "<!-- more-genui: {\"version\":1,\"id\":\"coin-2\",\"title\":\"硬币投掷·恰好k次正面概率\",\"stateVersion\":1} -->\n<html><body style=\"margin:0;padding:16px;background:var(--bg);color:var(--fg);font-family:system-ui,sans-serif;\">\n<div style=\"max-width:560px;margin:0 auto;\">\n<h2 style=\"color:var(--accent);font-weight:500;\">🪙 硬币投掷·恰好 k 次正面</h2>\n<p style=\"font-size:13px;opacity:0.75;\">独立公平硬币：P(X=k) = C(n,k)·(1/2)ⁿ。n 次投掷中恰好 k 次正面的二项分布。</p>\n<canvas id=\"c\" width=\"520\" height=\"220\" style=\"width:100%;background:#0e1c2c;border-radius:12px;\"></canvas>\n<div style=\"margin-top:12px;\"><label style=\"display:flex;justify-content:space-between;\">投掷次数 n <output id=\"nv\">10</output></label><input id=\"n\" type=\"range\" min=\"1\" max=\"20\" step=\"1\" value=\"10\" style=\"width:100%;\"></div>\n<div style=\"margin-top:8px;\"><label style=\"display:flex;justify-content:space-between;\">正面次数 k <output id=\"kv\">5</output></label><input id=\"k\" type=\"range\" min=\"0\" max=\"20\" step=\"1\" value=\"5\" style=\"width:100%;\"></div>\n<p id=\"info\" style=\"font-size:15px;margin-top:10px;color:var(--accent);font-weight:600;\"></p>\n</div>\n<script>\nconst c=document.getElementById('c'),ctx=c.getContext('2d'),n=document.getElementById('n'),k=document.getElementById('k');\nconst st=genui.getState();if(st.n!=null)n.value=st.n;if(st.k!=null)k.value=st.k;\nfunction C(n,k){if(k<0||k>n)return 0;let r=1;for(let i=1;i<=k;i++)r=r*(n-k+i)/i;return r;}\nfunction draw(){let N=+n.value,K=+k.value;if(K>N){K=N;k.value=N;}\ndocument.getElementById('nv').textContent=N;document.getElementById('kv').textContent=K;\nconst cw=c.width,ch=c.height;ctx.clearRect(0,0,cw,ch);ctx.fillStyle='#0e1c2c';ctx.fillRect(0,0,cw,ch);\nconst probs=[];let maxP=0;for(let i=0;i<=N;i++){const p=C(N,i)/Math.pow(2,N);probs.push(p);if(p>maxP)maxP=p;}\nconst barW=cw/(N+1)*0.75;const gap=cw/(N+1);\nconst targetP=probs[K];\nfor(let i=0;i<=N;i++){const hh=(probs[i]/maxP)*(ch-50);const x=i*gap+gap*0.125;const y=ch-20-hh;\nctx.fillStyle=(i===K)?'#ffd966':'#3f5f7a';ctx.fillRect(x,y,barW,hh);}\nctx.fillStyle='#fff';ctx.font='bold 15px system-ui';ctx.textAlign='center';\nctx.fillText(`P(X=${K}) = ${(targetP*100).toFixed(2)}%`,cw/2,20);\nconst pct=(targetP*100).toFixed(2);\ndocument.getElementById('info').textContent=`P(X=${K}) = C(${N},${K})/2^${N} = ${targetP.toFixed(5)} ≈ ${pct}%`;\ngenui.setState({n:N,k:K});}\nn.oninput=()=>{const N=+n.value;if(+k.value>N)k.value=N;draw();};\nk.oninput=draw;draw();\n</script></body></html>"
